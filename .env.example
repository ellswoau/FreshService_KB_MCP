# ---------------------------------------------------------------------------
# freshservice-kb configuration TEMPLATE.
# Copy to .env and fill in with real values. NEVER commit .env.
# Every value below is a placeholder - no real credential belongs in this file.
# ---------------------------------------------------------------------------

# --- FreshService (source of tickets) ---
FS_BASE_URL=https://your-domain.freshservice.com
FS_API_KEY=your-freshservice-api-key
FS_PER_PAGE=100

# --- Embeddings (choose ONE provider) ---
EMBED_PROVIDER=azure

# Option A: LiteLLM / any OpenAI-compatible /v1/embeddings endpoint
EMBED_BASE_URL=http://litellm.internal:4000
EMBED_API_KEY=your-litellm-api-key
EMBED_MODEL=text-embedding-3-large

# Option B: Azure OpenAI native
AOAI_ENDPOINT=https://your-resource.openai.azure.com
AOAI_API_KEY=your-azure-openai-key
AOAI_EMBED_DEPLOYMENT=text-embedding-3-large
AOAI_API_VERSION=2024-02-01

# Must match the model output size (3072 = text-embedding-3-large).
EMBED_DIMENSIONS=3072

# --- Azure AI Search ---
SEARCH_ENDPOINT=https://your-search.search.windows.net
SEARCH_API_KEY=your-azure-search-admin-key
SEARCH_INDEX_NAME=freshservice-kb-v1
SEARCH_API_VERSION=2024-07-01

# --- MCP retrieval server ---
# Bearer token gating the network MCP endpoint. Generate: openssl rand -hex 32
KB_MCP_AUTH_TOKEN=your-mcp-bearer-token
KB_BOOST_PATH=/app/feedback/boost.json

# --- Pipeline behaviour ---
STATE_DIR=.state
BATCH_SIZE=100
EMBED_BATCH_SIZE=16
DROP_SECRET_ONLY=true
MIN_SYMPTOM_CHARS=15
INTERVAL_HOURS=4
RECONCILE_HOUR_UTC=3
RUN_AT_START=true

# --- Correlated-ticket monitor (Phase 1) ---
# Fire when >= MONITOR_MIN_COUNT tickets share a description-text cluster key
# within MONITOR_WINDOW_MINUTES; one alert per key per cooldown; private note
# on the cluster's first ticket only.
MONITOR_DB_PATH=/data/monitor.sqlite
MONITOR_WINDOW_MINUTES=60
MONITOR_MIN_COUNT=3
MONITOR_COOLDOWN_MINUTES=120
MONITOR_INTERVAL_SECONDS=300
MONITOR_LOOKBACK_MINUTES=180
MONITOR_HEALTH_PORT=8016
MONITOR_DRY_RUN=false

# Phase 2 baseline gate: fire only when observed >= max(3, median + SIGMA*1.4826*MAD).
# Baseline is (system key = category/sub_category) x (day-of-week, hour) in TZ,
# computed from BASELINE_WEEKS of history every BASELINE_INTERVAL_HOURS.
MONITOR_BASELINE_ENABLED=true
MONITOR_BASELINE_WEEKS=8
MONITOR_BASELINE_TZ=America/Detroit
MONITOR_BASELINE_INTERVAL_HOURS=24
MONITOR_BASELINE_SIGMA=3.0

# Phase 3 corroborators: independent-system evidence (Graylog REST) attached to
# a fired alert. GRAYLOG_* mirror the graylog-mcp container's values; leave the
# token unset to disable corroboration.
GRAYLOG_URL=https://graylog.weller.corp
GRAYLOG_API_TOKEN=your-graylog-api-token
GRAYLOG_VERIFY_SSL=false
MONITOR_CORROBORATE_ENABLED=true
MONITOR_CORROBORATE_CAUSE_LOOKBACK_HOURS=24
MONITOR_CORROBORATE_EFFECT_LOOKBACK_HOURS=1
MONITOR_CORROBORATE_LIMIT=8

# Phase 3 corroborators via house MCP servers (Horizon pool status). URL is the
# horizon-mcp Streamable-HTTP endpoint; token mirrors horizon-mcp's env.
HORIZON_MCP_URL=http://10.201.28.110:8000/mcp
HORIZON_MCP_AUTH_TOKEN=***
HORIZON_MCP_VERIFY_SSL=true
MONITOR_HORIZON_ENABLED=true

# Change feed: recent FreshService changes (what/when/systems) as a cause
# corroborator, matched to the cluster by system keywords.
MONITOR_CHANGE_ENABLED=true
MONITOR_CHANGE_LOOKBACK_HOURS=72

# Prefer the FreshService MCP's richer list_changes; falls back to the direct
# FreshService API when unset.
FRESHSERVICE_MCP_URL=http://10.201.28.110:8001/mcp
FRESHSERVICE_MCP_AUTH_TOKEN=***
MONITOR_USE_FS_MCP_CHANGES=true

# SaaS vendor status pages (incidenthub.cloud), scraped (no API key).
MONITOR_SAAS_ENABLED=true
